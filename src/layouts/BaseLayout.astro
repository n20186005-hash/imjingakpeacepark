---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig } from '../config';
import { entity } from '../config/entity';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.ko;
const { messages } = getI18n(Astro.url);
const schema = messages.schema ?? {};

const entityFullName = entity.fullNameLocal[lang] ?? entity.fullName;
const ogImage = entity.heroImage;
const ogImageAlt = `${entityFullName} — main view in ${entity.city}, ${entity.country}`;

// 合并官方外链，保证 News/Knowledge Graph 与地图、旅游局门户互链（去重）
const sameAs = Array.from(
  new Set([
    entity.mapsShareUrl,
    entity.govtTourismUrl,
    ...(schema.sameAs ?? []),
  ]),
);

const jsonLd = {
  '@context': 'https://schema.org',
  // TouristAttraction 为主类型；并列 Park，帮助搜索引擎把页面锚定到「公园」这一实体类别
  '@type': ['TouristAttraction', 'Park'],
  // @id —— 帮助搜索引擎在 Knowledge Graph 中精确锚定该实体节点
  '@id': `${entity.baseUrl}/#attraction`,
  name: schema.name ?? entity.fullName,
  alternateName: schema.alternateName ?? [entity.shortName, entity.fullName],
  description: schema.description ?? messages.meta.description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: schema.image ?? entity.images,
  touristType: schema.touristType ?? ['History travelers', 'Families', 'Photographers'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: schema.streetAddress ?? entity.streetAddress,
    addressLocality: schema.addressLocality ?? entity.addressLocality,
    addressRegion: schema.addressRegion ?? entity.addressRegion,
    postalCode: schema.postalCode ?? entity.postalCode,
    addressCountry: entity.countryCode,
  },
  // NAP 一致性：电话与地图资料保持完全一致
  telephone: entity.telephone,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: schema.latitude ?? entity.latitude,
    longitude: schema.longitude ?? entity.longitude,
  },
  hasMap: entity.mapsShareUrl,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  isAccessibleForFree: schema.isAccessibleForFree ?? true,
  publicAccess: schema.publicAccess ?? true,
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'KRW',
      url: canonical,
      description: messages.meta.description,
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.4',
    reviewCount: '7477',
  },
  sameAs,
};
  const breadcrumbLd = (() => {
    const bc = messages.breadcrumb;
    return {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: bc.home, item: `${siteConfig.baseUrl}/${lang}` },
        { '@type': 'ListItem', position: 2, name: bc.region, item: `${siteConfig.baseUrl}/${lang}#overview` },
        { '@type': 'ListItem', position: 3, name: bc.city, item: `${siteConfig.baseUrl}/${lang}#transport` },
        { '@type': 'ListItem', position: 4, name: bc.current, item: canonical },
      ],
    };
  })();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="ja" href={alts.ja} />
    <link rel="alternate" hreflang="ko" href={alts.ko} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta property="og:site_name" content={entityFullName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- PWA / 品牌图标 -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.svg" />
    <meta name="theme-color" content="#0f2015" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={entity.shortName} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- PWA：注册 Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
