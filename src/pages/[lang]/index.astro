---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionNav from '../../components/SectionNav.astro';
import Hero from '../../components/Hero.astro';
import QuickFactsDashboard from '../../components/QuickFactsDashboard.astro';
import ComplianceGuide from '../../components/ComplianceGuide.astro';
import HigashiyamaRoute from '../../components/HigashiyamaRoute.astro';
import Intro from '../../components/Intro.astro';
import EntityOverview from '../../components/EntityOverview.astro';
import WeatherForecast from '../../components/WeatherForecast.astro';
import HeritageTimeline from '../../components/HeritageTimeline.astro';
import LegendsLore from '../../components/LegendsLore.astro';
import NatureDeepRead from '../../components/NatureDeepRead.astro';
import Facilities from '../../components/Facilities.astro';
import Transport from '../../components/Transport.astro';
import Lodging from '../../components/Lodging.astro';
import HumanitiesDossier from '../../components/HumanitiesDossier.astro';
import OutdoorMuseum from '../../components/OutdoorMuseum.astro';
import Gallery from '../../components/Gallery.astro';
import FeaturedQuotes from '../../components/FeaturedQuotes.astro';
import HiddenRules from '../../components/HiddenRules.astro';
import Reviews from '../../components/Reviews.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import DeepDive from '../../components/DeepDive.astro';
import FAQ from '../../components/FAQ.astro';
import { getI18n, languagesList } from '../../i18n/ui';
import { topicLinksByLang } from '../../i18n/topicLinks';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang } }));
}

const { lang, messages } = getI18n(Astro.url);
const faq = messages.faq;
const topicLinks = topicLinksByLang[lang] ?? topicLinksByLang.en;
const faqLd = (() => {
  const categories = faq?.categories ?? [];
  const mainEntity = categories.flatMap((cat) =>
    (cat.items ?? []).map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  );
  return {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity,
  };
})();
---

<BaseLayout title={messages.meta.title} description={messages.meta.description} path="">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>
  <Breadcrumbs />
  <SectionNav />
  <Hero />
  <QuickFactsDashboard />
  <WeatherForecast />
  <Intro />
  <EntityOverview />
  <HeritageTimeline />
  <HumanitiesDossier />
  <LegendsLore />
  <NatureDeepRead />
  <DeepDive />
  <Transport />
  <HigashiyamaRoute />
  <HiddenRules />
  <ComplianceGuide />
  <Facilities />
  <Lodging />
  <MapEmbed />
  <FAQ />
  <OutdoorMuseum />
  <Gallery />
  <FeaturedQuotes />
  <Reviews />
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl sm:text-3xl font-semibold mb-6" style="color: var(--text-primary);">{topicLinks.title}</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {topicLinks.items.map((it) => (
        <a href={`/${lang}/${it.slug}`} class="block rounded-2xl border p-5 transition hover:shadow-lg" style="border-color: var(--border-color); background: var(--card-bg); color: var(--text-primary);">
          <div class="text-xs uppercase tracking-wide" style="color: var(--accent);">{it.kicker}</div>
          <div class="mt-1 font-medium">{it.label}</div>
          <div class="mt-2 text-sm" style="color: var(--text-secondary);">{it.desc}</div>
        </a>
      ))}
    </div>
  </section>
  <SourcesSection />
</BaseLayout>
