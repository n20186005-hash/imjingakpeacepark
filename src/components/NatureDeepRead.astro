---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const n = messages.nature ?? {};
const topics = n.topics ?? [];
---

<section id="nature" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">
      {n.title}
    </h2>
    <p class="text-center text-base sm:text-lg mb-10 max-w-3xl mx-auto" style="color: var(--text-secondary);">
      {n.subtitle}
    </p>

    <div class="grid md:grid-cols-2 gap-5">
      {topics.map((topic) => (
        <article
          class="rounded-2xl border p-6 h-full"
          style="border-color: var(--border-color); background: var(--bg-primary);"
        >
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl leading-none" aria-hidden="true">{topic.icon}</span>
            <h3 class="font-display text-lg sm:text-xl font-semibold" style="color: var(--text-primary);">{topic.name}</h3>
          </div>
          <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{topic.lead}</p>
          {topic.points?.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm" style="color: var(--text-secondary);">
              {topic.points.map((point: string) => (
                <li class="flex gap-2 leading-relaxed">
                  <span aria-hidden="true" style="color: var(--accent);">▸</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    {n.note && (
      <p class="mt-8 text-xs leading-relaxed text-center max-w-3xl mx-auto" style="color: var(--text-muted);">
        {n.note}
      </p>
    )}
  </div>
</section>
