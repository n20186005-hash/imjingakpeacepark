---
import { getI18n, htmlLangAttr } from '../i18n/ui';
import { entity, mapsEmbedSrc } from '../config/entity';
const { lang, messages } = getI18n(Astro.url);
const m = messages.mapSection;
// 地图界面语言跟随页面语言：zh → zh-CN，en / ja / ko 原样，与 <html lang> 保持一致
const embedSrc = mapsEmbedSrc(htmlLangAttr(lang));
const e = messages.entity ?? {};
const nearbyTitle = messages.recommendations?.attractionsTitle ?? 'Nearby landmarks';
const nearby = entity.nearbyLandmarks;
const govUrl = e.govLinkUrl ?? entity.govtTourismUrl;
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={embedSrc}
        width="600"
        height="450"
        class="w-full h-[320px] sm:h-[450px]"
        style="border:0;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        title={`${entity.fullName} — Google Maps`}
      ></iframe>
    </div>

    <!-- 周边语义集群：列出周边核心地标 -->
    <div class="mt-8">
      <p class="text-xs uppercase tracking-[0.18em] mb-3 text-center" style="color: var(--text-muted);">{nearbyTitle}</p>
      <ul class="flex flex-wrap justify-center gap-2">
        {nearby.map((item) => (
          <li class="rounded-full px-3 py-1.5 text-sm border" style="border-color: var(--border-color); background: var(--card-bg); color: var(--text-secondary);">
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="text-center mt-8">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
    </div>

    <!-- 权威出站链接（官方旅游局门户） -->
    <p class="text-center text-sm sm:text-base mt-6 leading-relaxed" style="color: var(--text-secondary);">
      <a href={govUrl} target="_blank" rel="noopener noreferrer" class="font-medium" style="color: var(--accent);">
        {e.govLinkLabel} ↗
      </a>
    </p>
  </div>
</section>
